{
  "name": "@monodox/bugbase",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "@monodox/bugbase",
      "version": "0.1.0",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/@monodox/bugbase": {
      "resolved": "packages/cli",
      "link": true
    },
    "node_modules/@monodox/bugbase-mcp-server": {
      "resolved": "packages/mcp-server",
      "link": true
    },
    "packages/cli": {
      "name": "@monodox/bugbase",
      "version": "0.1.0",
      "license": "MIT",
      "bin": {
        "bugbase": "bin/bugbase.js"
      }
    },
    "packages/mcp-server": {
      "name": "@monodox/bugbase-mcp-server",
      "version": "0.1.0",
      "license": "MIT"
    }
  }
}
